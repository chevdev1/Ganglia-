ENV=development
SECRET_KEY=change-me-in-production
ADMIN_TOKEN=change-me-admin

# Free model (no credit card): https://console.groq.com/keys
# Paste the gsk_ key on either line. Groq is OpenAI-compatible.
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_JSON_MODE=true

# Without a key the local software writer still runs.
ALLOW_SOFTWARE_WRITER=true
AUTONOMOUS_SECONDS=60
SCENARIO_COOLDOWN_SECONDS=45
AUTONOMOUS_ENABLED=true
TTS_ENABLED=true
TTS_VOICE=en-US-JennyNeural

# Free WalletConnect / Reown Project ID: https://cloud.reown.com
# Enables QR + Trust / MetaMask / Rainbow / Coinbase list (like Void).
WALLETCONNECT_PROJECT_ID=
