ENV=development
SECRET_KEY=change-me-in-production
ADMIN_TOKEN=change-me-admin

# Free model (no credit card): https://console.groq.com/keys
# Paste the gsk_ key on either line. Groq is OpenAI-compatible.
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_JSON_MODE=true

# Without a key the local software writer still runs.
ALLOW_SOFTWARE_WRITER=true
AUTONOMOUS_SECONDS=60
SCENARIO_COOLDOWN_SECONDS=45
AUTONOMOUS_ENABLED=true
TTS_ENABLED=true
TTS_VOICE=en-US-JennyNeural

# Free WalletConnect / Reown Project ID: https://cloud.reown.com
# Enables QR + Trust / MetaMask / Rainbow / Coinbase list (like Void).
WALLETCONNECT_PROJECT_ID=

# Robinhood Chain node sale. Leave empty = purchase stays "coming soon", nothing is charged.
# Fill ALL of chain_id, rpc, sale contract and price to switch the site to on-chain buying
# (free /claim closes automatically once enabled).
CHAIN_ID=
CHAIN_NAME=Robinhood Chain
CHAIN_RPC_URL=
CHAIN_EXPLORER_URL=
CHAIN_CURRENCY_SYMBOL=ETH
CHAIN_CURRENCY_DECIMALS=18
SALE_CONTRACT_ADDRESS=
SALE_FUNCTION=buyNode(uint256)
NODE_PRICE_WEI=
GNGL_TOKEN_ADDRESS=
